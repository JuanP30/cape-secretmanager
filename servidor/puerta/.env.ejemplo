# Copia este archivo a .env (en el servidor, nunca en git) y rellénalo. Guía: docs/1-servidor.md
PUERTA_DOMINIO=puerta.tu-dominio.com
VW_URL=https://vault.tu-dominio.com
TRAEFIK_RED=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
# Llaves del usuario de servicio «puerta» del vault (Vaultwarden → Configuración → Seguridad → Llaves → API key)
PUERTA_CLIENT_ID=user.xxxxxxxx
PUERTA_CLIENT_SECRET=
PUERTA_MASTER=
# Opcional: correo de invitación. Un webhook que reciba {"raw": <correo MIME en base64url>} y lo envíe
# (el mismo que usa servidor/vaultwarden/cape-sendmail, p. ej. un flujo de n8n con Gmail).
# Sin esto, la app muestra el código de alta para pasarlo a mano.
CORREO_WEBHOOK=
CORREO_CLAVE=
# Opcional: enlace al repo, para el correo de invitación.
CAPE_REPO=
