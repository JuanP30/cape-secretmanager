# Copia este archivo a .env (en el servidor, nunca en git) y rellénalo. Guía: docs/1-servidor.md
PUERTA_DOMINIO=puerta.tu-dominio.com
VW_URL=https://vault.tu-dominio.com
TRAEFIK_RED=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
# Llaves del usuario de servicio «puerta» del vault (Vaultwarden → Configuración → Seguridad → Llaves → API key)
PUERTA_CLIENT_ID=user.xxxxxxxx
PUERTA_CLIENT_SECRET=
PUERTA_MASTER=
